{
  "timeout_seconds": 1800,
  "token_limits": { "main": 1000000, "code": 1000000, "review": 250000, "e2e": 150000 },
  "soft_token_limits": { "main": 700000, "code": 700000, "review": 175000, "e2e": 100000 },
  "bootstrap_files": [".workflow.json", ".gitignore", "scripts/workflow-integration.sh"],
  "openspec_validate": true,
  "require_design_tasks": true,
  "setup_commands": [["pnpm", "install", "--frozen-lockfile"]],
  "agents": {
    "main": { "provider": "codex", "model": "gpt-5.6-sol", "reasoning_effort": "low" },
    "code": { "provider": "codex", "model": "gpt-5.6-sol", "reasoning_effort": "high" },
    "review": { "provider": "codex", "model": "gpt-5.6-sol", "reasoning_effort": "medium" },
    "test": { "provider": "codex", "model": "gpt-5.6-sol", "reasoning_effort": "low" }
  },
  "gates": {
    "build": ["pnpm", "run", "build"],
    "static": ["pnpm", "run", "lint"],
    "test": ["pnpm", "run", "test:unit"],
    "acceptance": ["bash", "scripts/workflow-integration.sh"]
  },
  "commands": {
    "e2e": ["bash", "scripts/workflow-integration.sh"]
  },
  "draft": {
    "provider": "github",
    "base": "main"
  }
}
